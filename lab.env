# ─────────────────────────────────────────────────────────────────────────────
# nginx-sec-lab -- Lab Configuration
# Edit this file before running 'task up'
# ─────────────────────────────────────────────────────────────────────────────

# Host IP -- the Ubuntu lab machine's IP reachable by external clients
# Run: ip route get 1.1.1.1 | grep -oP 'src \K[\d.]+'
LAB_HOST_IP=172.16.1.136

# Base domain for all lab apps
LAB_DOMAIN=lab.local

# App hostnames (derived from LAB_DOMAIN -- change if needed)
CRAPI_HOST=crapi.${LAB_DOMAIN}
JUICESHOP_HOST=juiceshop.${LAB_DOMAIN}
DVGA_HOST=dvga.${LAB_DOMAIN}
VAPI_HOST=vapi.${LAB_DOMAIN}

# Cluster name
CLUSTER_NAME=nginx-sec-lab

# CNI: kindnet (default) or cilium
CNI=kindnet
