# ─────────────────────────────────────────────────────────────────────────────
# nginx-sec-lab -- Lab Configuration
# Edit this file before running 'task up'
# Credentials go in lab.secrets (gitignored)
#
# DISK REQUIREMENT: 40GB minimum, 60GB recommended
#   If pods evict with disk-pressure taint, expand the VM disk:
#   1. Proxmox: VM > Hardware > Hard Disk > Resize
#   2. Ubuntu:  sudo growpart /dev/sda 2 && sudo resize2fs /dev/sda2
# ─────────────────────────────────────────────────────────────────────────────

# ── Network ───────────────────────────────────────────────────────────────────
# Host IP of the Ubuntu lab machine (reachable by external clients)
# Run: ip route get 1.1.1.1 | grep -oP 'src \K[\d.]+'
LAB_HOST_IP=172.16.20.145

# Base domain for all lab apps
LAB_DOMAIN=laptop.test

# ── Cluster ───────────────────────────────────────────────────────────────────
CLUSTER_NAME=nginx-sec-lab

# CNI: kindnet (default) | cilium
CNI=kindnet

# ── Resource control ──────────────────────────────────────────────────────────
# Number of k3d agent nodes (server is always 1). Fewer agents = less memory.
# Minimum 0 (server-only), typical 1-2. Changing this requires 'task reset'.
LAB_AGENTS=2

# Apps to deploy. Space-separated. Valid: crapi juiceshop dvga vampi
# Approximate memory cost:
#   crapi      ~2.0 GB  (heaviest -- full Java/Python/Node stack)
#   juiceshop  ~0.3 GB
#   dvga       ~0.2 GB
#   vampi      ~0.1 GB  (lightest -- single Flask container)
# Drop crapi first if memory is tight. Changes take effect on next
# 'task apps:down && task apps:up' (no cluster rebuild needed).
LAB_APPS="crapi juiceshop dvga vampi"

# ── Lab mode ──────────────────────────────────────────────────────────────────
# NGINX_MODE: oss (default) | plus
NGINX_MODE=oss# ── Service exposure mode ─────────────────────────────────────────────────────
# SVC_MODE controls how demo app Services are exposed.
#
#   clusterip  (default) -- Services are ClusterIP. External access goes through
#              NIC ingress: https://<app>.<LAB_DOMAIN>. Required for WAF testing
#              and TLS scenarios. No extra port bindings needed.
#
#   nodeport   -- Services are NodePort. Apps are also reachable directly at
#              http://<LAB_HOST_IP>:<nodeport>, bypassing NIC entirely.
#              Useful for: raw HTTP scanning, BIG-IP CIS NodePort pool members,
#              tools that don't support SNI/TLS.
#              Requires the NodePort range to be bound at cluster creation (set
#              in scripts/create-cluster.sh -- changing it needs 'task reset').
#
# Switch at runtime (no cluster rebuild):
#   task svc:nodeport   -- apply NodePort overlays
#   task svc:clusterip  -- revert to ClusterIP overlays
#
# Both modes can coexist: NIC still serves HTTPS while NodePort is active.
SVC_MODE=clusterip

# ── NodePort assignments ───────────────────────────────────────────────────────
# Fixed ports in the 30080-30600 range bound at cluster creation.
# Only used when SVC_MODE=nodeport (or after 'task svc:nodeport').
# Changing these values requires updating the overlay kustomization.yaml files
# AND rebuilding the cluster (task reset) if the new ports fall outside the
# bound range.
LAB_NODEPORT_CRAPI=30080
LAB_NODEPORT_JUICESHOP=30300
LAB_NODEPORT_DVGA=30501
LAB_NODEPORT_VAMPI=30082
# ── NGINX Ingress (NIC) service exposure ──────────────────────────────────────
# Klipper (k3s servicelb) is disabled at cluster creation, so NIC cannot be
# type LoadBalancer. BIG-IP CIS is the load balancer. NIC is exposed as either
# NodePort or ClusterIP, and the choice MUST be paired with the CIS mode:
#
#   NIC_SVC_MODE=nodeport   <->  task bigip:cis:install CIS_MODE=nodeport
#       BIG-IP pool members = node IP : NIC NodePort. Works with any CNI.
#       This is the simplest, k3d-friendly path. (default)
#
#   NIC_SVC_MODE=clusterip  <->  task bigip:cis:install CIS_MODE=cluster
#       BIG-IP pool members = NIC pod IPs directly. Requires Cilium + the
#       BIG-IP VTEP tunnel (task bigip:tunnel:setup). Without VTEP, BIG-IP
#       cannot reach pod IPs and every request fails.
#
# Mixing modes (e.g. NIC clusterip + CIS nodeport) is the #1 cause of
# "NIC and BIG-IP work sometimes but not others." Keep them paired.
#
# Switch at runtime (re-syncs only the NIC release, no cluster rebuild):
#   task nic:nodeport
#   task nic:clusterip
#   task nic:status
NIC_SVC_MODE=nodeport

# NIC NodePorts. The k3d host-port proxy maps host 80->NIC_HTTP_NODEPORT and
# host 443->NIC_HTTPS_NODEPORT so `task test`/`task health` keep working on
# standard ports. Changing these requires updating values/nginx-ingress.yaml
# (httpPort.nodePort / httpsPort.nodePort) AND `task reset`.
# Must be in 30000-32767 and not collide with app NodePorts
# (crapi 30080, juiceshop 30300, dvga 30501, vampi 30082).
NIC_HTTP_NODEPORT=30000
NIC_HTTPS_NODEPORT=30443
